NODE_ENV=development
PORT=4000

# Required Firebase Admin credential for the backend.
# Keep the JSON on one line with escaped newlines in private_key.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com"}

# Browser origins allowed to call the backend.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Current-stack defaults
PAYWALL_AMOUNT_USD=13
AUTH_COOKIE_MAX_AGE_SECONDS=1800
RATE_LIMIT_MAX_BUCKETS=10000

# Polar.sh billing configuration (appointment consultation-fee checkout).
# POLAR_WEBHOOK_SECRET is optional — leave blank and the backend will
# auto-register its own webhook endpoint with Polar using BACKEND_PUBLIC_URL
# and use the secret Polar generates for it.
POLAR_ENV=sandbox
POLAR_ACCESS_TOKEN=polar_oat_XP9FN5WCBJtbI9MxGG8X4ffiCMflWYxQyK9Ef2aC0qj
POLAR_WEBHOOK_SECRET=whsec_9AqUA6OtbivMtSHK99lhedi8CNQTg7iZdkHjZ3MW2sg
BACKEND_PUBLIC_URL=http://localhost:4000
